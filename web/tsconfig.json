{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": { "react-native": ["./src/rn-shim.ts"] }
  },
  "include": ["src", "../src/data.ts", "../src/utils.ts", "../src/location.ts"]
}
