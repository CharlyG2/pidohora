{
  "name": "pidohora-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start -w @pidohora/mobile",
    "mobile:web": "npm run web -w @pidohora/mobile",
    "web": "npm run dev -w @pidohora/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:web": "npm run build -w @pidohora/web",
    "test:db": "bash scripts/test-db.sh"
  },
  "devDependencies": {
    "typescript": "~7.0.2"
  }
}
